# Database
DATABASE_URL=postgresql+asyncpg://netlv:netlv_secret@localhost:5432/netlanventory
POSTGRES_DB=netlanventory
POSTGRES_USER=netlv
POSTGRES_PASSWORD=netlv_secret

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
LOG_LEVEL=INFO

# Security
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# AI Triage (innovation #3) — PREVIEW, disabled by default.
# When disabled the /triage endpoints return 503. To enable, set
# AI_TRIAGE_ENABLED=true and provide a provider below (+ Redis for the cost guard).
AI_TRIAGE_ENABLED=false
AI_PROVIDER=ollama                       # ollama (local, default) or anthropic
OLLAMA_BASE_URL=http://localhost:11434   # used when AI_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
ANTHROPIC_API_KEY=                        # required when AI_PROVIDER=anthropic
AI_TRIAGE_DAILY_BUDGET=200000             # token/day cap; needs REDIS_URL to enforce
# REDIS_URL=redis://localhost:6379/0      # recommended: without it the cost guard is a no-op
